{
  "buildCommand": "npm install",
  "env": {
    "SMTP_HOST": "@smtp_host",
    "SMTP_PORT": "@smtp_port",
    "SMTP_SECURE": "@smtp_secure",
    "SMTP_USER": "@smtp_user",
    "SMTP_PASSWORD": "@smtp_password",
    "RECIPIENT_EMAIL": "@recipient_email",
    "SENDER_NAME": "@sender_name",
    "EMAIL_SUBJECT": "@email_subject"
  },
  "public": true
}
